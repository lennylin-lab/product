TZ=Asia/Taipei

MYSQL_PORT=33066
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=product
MYSQL_USER=product
MYSQL_PASSWORD=product123

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:33066/product?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FTaipei
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

REDIS_PORT=6380
REDIS_PASSWORD=123456
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_DATABASES=16
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6380
SPRING_DATA_REDIS_PASSWORD=123456
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=10000ms

TOKEN_SECRET=dev-token-secret
PRODUCT_UPLOAD_PATH=./uploadPath
PRODUCT_LOG_PATH=./logs
SERVICE_NAME=product-server
APP_ENV=local
ELASTICSEARCH_PORT=9201
KIBANA_PORT=5601
LOGSTASH_BEATS_PORT=5044
LOGSTASH_API_PORT=9600
ES_JAVA_OPTS="-Xms1g -Xmx1g"
LS_JAVA_OPTS="-Xms512m -Xmx512m"

# ---- Spring Cloud Alibaba 微服务基础设施（Phase 1） ----
# Nacos（v3 镜像即使 AUTH_ENABLE=false 也要求提供 token/identity）
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8090
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=product-dev
# RabbitMQ（AMQP 端口 5672；管理台默认 15673，避开本机已占用端口可自行调整）
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15673
# 服务骨架运行期环境变量（可选，默认值见各服务 application.yml）
# NACOS_SERVER_ADDR=127.0.0.1:8848
# NACOS_NAMESPACE=dev

# Identity（Phase 2）：身份库账号（identity_schema.sql 的默认密码与之保持一致）
# IDENTITY_DB_HOST=127.0.0.1
# IDENTITY_DB_PORT=33066
# IDENTITY_DB_PASSWORD=identity-dev-pwd
# JWT RS256 签名私钥（PEM/PKCS#8，生产必须注入；留空=临时开发密钥，重启后 token 失效）
# IDENTITY_JWT_PRIVATE_KEY=
# 轮换窗口公钥（PEM/X.509，可选）
# IDENTITY_JWT_PREVIOUS_PUBLIC_KEY=

# Master Data / Demand（Phase 3）：服务库账号（master_data_schema.sql / demand_schema.sql
# 的默认密码与之保持一致）
# MASTER_DATA_DB_HOST=127.0.0.1
# MASTER_DATA_DB_PORT=33066
# MASTER_DATA_DB_PASSWORD=master-data-dev-pwd
# DEMAND_DB_HOST=127.0.0.1
# DEMAND_DB_PORT=33066
# DEMAND_DB_PASSWORD=demand-dev-pwd

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.product</groupId>
        <artifactId>product-services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>product-gateway</artifactId>

    <name>product-gateway</name>
    <description>product-gateway: 统一入口网关骨架（Spring Cloud Gateway WebFlux + Nacos + Sentinel）</description>

    <dependencies>
        <!-- Spring Cloud Gateway（SC 2025.0.x 命名，ADR-0001） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- 注册中心与配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 流量治理：Sentinel 网关适配（ADR-0001：必须使用 SCA 的 sentinel-gateway 模块） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
        </dependency>
        <!-- Phase 6：Sentinel 规则 Nacos 持久化（sentinel-datasource；版本由 SCA BOM 管理，1.8.9）。
             网关流控规则 dataId=product-gateway-flow-rules.json（group=PRODUCT_GATEWAY，namespace=dev），
             规则 JSON 推送后经 GatewayRuleManager 热加载；application.yml 中的
             product.gateway.sentinel.routes 属性规则仍作为 Nacos 未发布配置时的兜底默认。 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <!-- 可观测性基线：健康检查/指标/追踪 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Phase 6：OTLP span 导出（management.otlp.tracing.endpoint；导出开关见 application.yml） -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- OpenAPI：网关聚合各服务文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>

        <!-- 共享基础库（日志基线等；SERVLET 条件 Bean 在 WebFlux 下自动跳过） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-cloud-common</artifactId>
        </dependency>
        <!-- JWT 本地验签核心（JwksKeyHolder/JwtVerifier；servlet 安全链对 WebFlux 不生效，ADR-0003） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-cloud-security</artifactId>
        </dependency>
        <!-- Micrometer Tracer（网关错误响应回写 X-Trace-Id 用） -->

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

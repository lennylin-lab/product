<?xml version="1.0" encoding="UTF-8"?>
<!--
  说明：本模块 Maven 坐标为 product-demand-service，因为现有单体业务模块已占用
  com.product:product-demand 坐标（同 reactor 内 GAV 冲突）。服务运行名
  （spring.application.name / Nacos 注册名）仍为 ADR-0002 规定的 product-demand。
  Phase 3 迁移完成后旧 product-demand 模块退役，届时可回收该坐标。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.product</groupId>
        <artifactId>product-services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>product-demand-service</artifactId>

    <name>product-demand-service</name>
    <description>product-demand-service: 需求域服务骨架（客户、订单、订单行及订单生命周期；运行名 product-demand，ADR-0002）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-cloud-common</artifactId>
        </dependency>
        <!-- 认证基线：本地验签安全链（ADR-0003：直连服务端口必须携带有效签名 token；
             服务端两层校验的服务侧，servlet 安全链由 cloud-security 自动装配） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-cloud-security</artifactId>
        </dependency>
        <!-- 事件一致性基础设施（Phase 5，ADR-0004）：消费 batch.progress.changed 推进
             订单行/订单状态；order_line.progress.changed 经 Outbox 出站；死信审计与人工重放 -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-cloud-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 主数据服务契约（ADR-0002 决策 5）：订单行 product_id 跨域引用校验经
             MasterDataBatchQueryApi（OpenFeign, name=product-master-data）调用 master-data，
             禁止跨服务读写他方表（demand→pps Java 依赖消除后的替代通道） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-master-data-api</artifactId>
        </dependency>
        <!-- 本服务对外契约（Phase 4：InternalDemandController 实现 DemandBatchQueryApi，
             排程版本化输入快照与拆批数量预占的提供端） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-demand-api</artifactId>
        </dependency>
        <!-- 计划服务契约（Phase 4，ADR-0005）：订单行详情 ProductionBatchView 填充、
             删除订单行时级联清理 planning 批次（单体同事务级联的跨服务等价实现） -->
        <dependency>
            <groupId>com.product</groupId>
            <artifactId>product-planning-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- 负载均衡：nacos-discovery 传递引入，显式声明以表达 Feign 服务名解析依赖 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 数据访问：MyBatis-Plus（版本由根 POM 管理，与单体一致）；demand_db 独立数据源（ADR-0005） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Excel 导入导出（客户/订单/订单行 /export /importTemplate /importData；版本由根 POM 管理） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Lombok（实体 @Data/@EqualsAndHashCode，与单体 domain 实体同款） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

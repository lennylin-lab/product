<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.product</groupId>
        <artifactId>product</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>product-services</artifactId>
    <packaging>pom</packaging>

    <name>product-services</name>
    <description>product-services: Spring Cloud Alibaba 微服务骨架聚合工程（Phase 1，ADR-0002 服务边界）</description>

    <modules>
        <module>product-cloud-common</module>
        <module>product-cloud-security</module>
        <module>product-master-data-api</module>
        <module>product-demand-api</module>
        <module>product-planning-api</module>
        <module>product-gateway</module>
        <module>product-identity</module>
        <module>product-master-data</module>
        <module>product-demand-service</module>
        <module>product-planning</module>
        <module>product-execution</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 微服务体系内部共享基础库 -->
            <dependency>
                <groupId>com.product</groupId>
                <artifactId>product-cloud-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.product</groupId>
                <artifactId>product-cloud-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 服务契约模块（ADR-0002 决策 1：每服务独立 API contract，禁止共享持久化 Entity） -->
            <dependency>
                <groupId>com.product</groupId>
                <artifactId>product-master-data-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.product</groupId>
                <artifactId>product-demand-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.product</groupId>
                <artifactId>product-planning-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
